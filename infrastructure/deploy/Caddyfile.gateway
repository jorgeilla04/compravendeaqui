# Gateway propio de CompraVendeAqui (dentro del stack, sin HTTPS: lo hace el
# Caddy de entrada del servidor). Reparte el tráfico del dominio.
{
	auto_https off
	admin off
	servers {
		# El Caddy de entrada llega por la red de Docker: se confía en su
		# X-Forwarded-For para conocer la IP real del visitante.
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip
	request_body {
		max_size 25MB
	}

	handle /api/* {
		reverse_proxy api:8000 {
			header_up X-Real-IP {client_ip}
		}
	}

	handle /health* {
		reverse_proxy api:8000
	}

	# Fotos públicas: /media/<key> → bucket compravende-media en MinIO.
	handle_path /media/* {
		rewrite * /compravende-media{path}
		reverse_proxy minio:9000 {
			header_up Host minio:9000
		}
		header Cache-Control "public, max-age=31536000, immutable"
	}

	handle {
		reverse_proxy web:3000
	}
}
