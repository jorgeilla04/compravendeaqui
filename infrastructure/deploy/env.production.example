# /opt/compravendeaqui/.env — producción. chmod 600. NUNCA commitear.
# El deploy.sh genera los secretos la primera vez si este archivo no existe.

PUBLIC_SITE_URL=https://compravendeaqui.com.ar
CORS_ORIGINS=https://compravendeaqui.com.ar,https://www.compravendeaqui.com.ar
COOKIE_SECURE=true
LOG_LEVEL=INFO

# Secretos (generados)
JWT_SECRET_KEY=
POSTGRES_PASSWORD=

# MinIO propio del stack. Root: solo administración (no lo recibe la API).
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Usuario de la app, limitado al bucket de fotos (lo crea deploy.sh).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=compravende-media
S3_PUBLIC_BASE_URL=https://compravendeaqui.com.ar/media

# Ingreso por email (ver backend/.env.example). Completar SMTP_* con el
# proveedor de mail; sin eso el envío del código responde 503.
LOGIN_METHOD=email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM="CompraVendeAqui <no-responder@compravendeaqui.com.ar>"

# Ingreso por celular (LOGIN_METHOD=phone): WhatsApp y SMS de respaldo.
OTP_CHANNELS=whatsapp,sms
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LANGUAGE=es_AR
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

FX_API_URL=https://dolarapi.com/v1/dolares/blue
