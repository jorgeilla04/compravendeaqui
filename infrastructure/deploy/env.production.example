# /opt/compravendeaqui/.env — producción. chmod 600. NUNCA commitear.
# El deploy.sh genera los secretos la primera vez si este archivo no existe.

PUBLIC_SITE_URL=https://compravendeaqui.com.ar
CORS_ORIGINS=https://compravendeaqui.com.ar,https://www.compravendeaqui.com.ar
COOKIE_SECURE=true
LOG_LEVEL=INFO

# Secretos (generados)
JWT_SECRET_KEY=
POSTGRES_PASSWORD=

# MinIO propio del stack. Root: solo administración (no lo recibe la API).
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Usuario de la app, limitado al bucket de fotos (lo crea deploy.sh).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=compravende-media
S3_PUBLIC_BASE_URL=https://compravendeaqui.com.ar/media

# Ingreso por email (ver backend/.env.example). Completar SMTP_* con el
# proveedor de mail; sin eso el envío del código responde 503.
LOGIN_METHOD=email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM="CompraVendeAqui <no-responder@compravendeaqui.com.ar>"

# Ingreso por celular (LOGIN_METHOD=phone): WhatsApp y SMS de respaldo.
OTP_CHANNELS=whatsapp,sms
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LANGUAGE=es_AR
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# =====================================================================
# Tienda de uniformes escolares (/uniformes)
# =====================================================================
UNIFORMES_ENVIO_MONTO=5000
UNIFORMES_EXPRESS_RECARGO_PCT=20
# Seña: % de los uniformes + envío (y recargo express), por adelantado.
UNIFORMES_SENA_PCT=10
UNIFORMES_VENDEDORA_NOMBRE="Virginia Tello"
UNIFORMES_VENDEDORA_EMAIL=virginialauratello@gmail.com
UNIFORMES_VENDEDORA_WHATSAPP=+5492645408193
UNIFORMES_RETIRO_DIRECCION="Santiago del Estero Sur 1131, Capital"

# --- Mercado Pago (Checkout Pro) -------------------------------------
# Mercado Pago Developers → Tus integraciones → (tu app) → Credenciales de
# producción → Access Token (APP_USR-...). Sin token, los pedidos quedan
# "a coordinar" y le llegan a la vendedora por mail.
MP_ACCESS_TOKEN=
# Tus integraciones → Webhooks → Clave secreta. Obligatoria en producción si
# hay token. URL a configurar ahí (evento "Pagos"):
#   https://compravendeaqui.com.ar/api/v1/uniformes/webhooks/mercadopago
MP_WEBHOOK_SECRET=
MP_STATEMENT_DESCRIPTOR=COMPRAVENDEAQUI

FX_API_URL=https://dolarapi.com/v1/dolares/blue
