# --- CompraVendeAqui backend — variables de entorno ---
# Copiá este archivo a .env y ajustá los valores. NUNCA commitees .env.

# Entorno: development | staging | production
ENVIRONMENT=development
DEBUG=true

# API
PROJECT_NAME=CompraVendeAqui
API_V1_PREFIX=/api/v1

# Base de datos (PostgreSQL LOCAL de la máquina).
# Opción trust (usuario del sistema, sin password):
#   postgresql+psycopg://TU_USUARIO@localhost:5432/compravende
# Opción con usuario/clave:
#   postgresql+psycopg://usuario:clave@localhost:5432/compravende
DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/compravende

# Redis LOCAL — usá un índice de DB dedicado para no chocar con otros proyectos
REDIS_URL=redis://localhost:6379/5

# CORS: orígenes permitidos separados por coma
CORS_ORIGINS=http://localhost:3000

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# URL pública del frontend (links de avisos, sitemap y mensaje de WhatsApp)
PUBLIC_SITE_URL=http://localhost:3000

# =====================================================================
# Auth / JWT
# =====================================================================
# Obligatorio en producción. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# En producción: COOKIE_SECURE=true y COOKIE_DOMAIN=.tudominio.com.ar
# (el mismo dominio padre para la web y la API).
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Proxies de confianza (IPs o CIDR) cuyo X-Real-IP se usa para rate limiting.
# Nginx en la misma máquina: 127.0.0.1,::1 · Nginx en Docker: 172.16.0.0/12
TRUSTED_PROXIES=127.0.0.1,::1

# =====================================================================
# OTP — envío del código de ingreso
# =====================================================================
# Canales en orden de preferencia. Si el primero falla se usa el siguiente.
# Solo se usan los canales que tengan sus credenciales completas.
# Sin ningún canal configurado, POST /auth/otp/request responde 503.
OTP_CHANNELS=whatsapp,sms
OTP_TTL_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5

# --- WhatsApp Cloud API (Meta) ---------------------------------------
# 1. Meta Business Manager → verificar la empresa.
# 2. developers.facebook.com → app tipo Business → producto WhatsApp.
# 3. Registrar el número de la empresa → copiar el "Phone number ID".
# 4. Crear un usuario del sistema con permiso whatsapp_business_messaging
#    y generar un token PERMANENTE (el temporal de la consola vence en 24 h).
# 5. Crear una plantilla de categoría AUTHENTICATION, idioma es_AR, con el
#    botón "Copiar código", y esperar la aprobación.
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LANGUAGE=es_AR

# --- Twilio SMS (respaldo) -------------------------------------------
# console.twilio.com → Account SID y Auth Token.
# Usar un número remitente O un Messaging Service (recomendado).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# =====================================================================
# Cotización USD/ARS (normaliza precios para filtrar y ordenar)
# =====================================================================
# DolarApi: /v1/dolares/blue | /v1/dolares/oficial | /v1/dolares/mep
FX_API_URL=https://dolarapi.com/v1/dolares/blue
FX_RATE_FIELD=venta
FX_CACHE_MINUTES=30

# =====================================================================
# Imágenes — almacenamiento S3 compatible (AWS S3, MinIO, Cloudflare R2)
# =====================================================================
# Local con MinIO (brew services start minio):
#   S3_ENDPOINT_URL=http://localhost:9000
#   S3_PUBLIC_BASE_URL=http://localhost:9000/compravende-media
# Crear el bucket con lectura pública:  python -m app.scripts.setup_storage
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=compravende-media
S3_PUBLIC_BASE_URL=http://localhost:9000/compravende-media
